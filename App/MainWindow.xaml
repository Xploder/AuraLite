<Window x:Class="AuraLite.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AuraLite"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    Title="AuraLite">
    <Window.SystemBackdrop>
        <media:MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" RequestedTheme="Dark" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="WindowTitleBar" Title="AuraLite">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/AuraLite.png" ShowAsMonochrome="False" />
            </TitleBar.IconSource>
        </TitleBar>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="28,16,28,22" Spacing="14" MaxWidth="900">
                <Border CornerRadius="12" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid x:Name="LightingGrid" ColumnSpacing="20">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Wide">
                                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="680" /></VisualState.StateTriggers>
                                </VisualState>
                                <VisualState x:Name="Narrow">
                                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="LightingControls.(Grid.Row)" Value="1" />
                                        <Setter Target="LightingControls.(Grid.Column)" Value="0" />
                                        <Setter Target="LightingControls.Margin" Value="0,16,0,0" />
                                        <Setter Target="Picker.(Grid.ColumnSpan)" Value="2" />
                                        <Setter Target="LightingControls.(Grid.ColumnSpan)" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ColorPicker x:Name="Picker" ColorChanged="ColorChanged" Color="#64D6C4" IsAlphaEnabled="False"
                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                     IsColorPreviewVisible="True" HorizontalAlignment="Left" />
                        <StackPanel x:Name="LightingControls" Grid.Column="1" Spacing="10">
                            <TextBlock x:Name="LightingHeading" FontSize="21" FontWeight="SemiBold" />
                            <ComboBox x:Name="Channels" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="Mode" SelectionChanged="ModeChanged" HorizontalAlignment="Stretch" />
                            <Slider x:Name="Brightness" ValueChanged="BrightnessChanged" Minimum="0" Maximum="100" Value="30" StepFrequency="1" />
                            <NumberBox x:Name="LedCount" ValueChanged="LedCountChanged" Minimum="1" Maximum="120" Value="1" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border CornerRadius="12" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ProfilesHeading" FontSize="21" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="Profiles" SelectionChanged="ProfileSelected" HorizontalAlignment="Stretch" />
                            <Button x:Name="NewProfileButton" Grid.Column="1" Click="NewProfileClicked" />
                            <Button x:Name="ProfileActions" Grid.Column="2" IsEnabled="False">
                                <FontIcon Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="UpdateProfileItem" Click="UpdateProfileClicked" />
                                        <MenuFlyoutItem x:Name="DeleteProfileItem" Click="DeleteClicked" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Grid x:Name="NewProfileForm" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProfileName" MaxLength="60" KeyDown="ProfileNameKeyDown" />
                            <Button x:Name="SaveProfileButton" Grid.Column="1" Click="SaveClicked" />
                            <Button x:Name="CancelProfileButton" Grid.Column="2" Click="CancelProfileClicked" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="StartupProfile" SelectionChanged="StartupProfileChanged" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="LanguagePicker" Grid.Column="1" SelectionChanged="LanguageChanged" HorizontalAlignment="Stretch" />
                </Grid>
                <StackPanel Spacing="4">
                    <local:SettingsCheckBox x:Name="RestoreLighting" Checked="RestoreLightingChanged" Unchecked="RestoreLightingChanged">
                        <TextBlock x:Name="RestoreLightingLabel" TextWrapping="Wrap" />
                    </local:SettingsCheckBox>
                    <local:SettingsCheckBox x:Name="Autostart" Checked="AutostartChanged" Unchecked="AutostartChanged">
                        <TextBlock x:Name="AutostartLabel" TextWrapping="Wrap" />
                    </local:SettingsCheckBox>
                </StackPanel>
                <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" />
                <Button x:Name="ScanButton" Click="ScanClicked" HorizontalAlignment="Right" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
